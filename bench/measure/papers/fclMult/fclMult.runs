-- forward: 3 * 4 = 12
? run [Blk Init [Asg (S (S O)) (Const O)] (Goto Test), Blk Test [] (IfZ (Var O) Done Outer), Blk Outer [Asg O (Pred (Var O)), Asg (S (S (S O))) (Var (S O))] (Goto Inner), Blk Inner [] (IfZ (Var (S (S (S O)))) Test Step), Blk Step [Asg (S (S (S O))) (Pred (Var (S (S (S O))))), Asg (S (S O)) (Succ (Var (S (S O))))] (Goto Inner), Blk Done [] (Return (Var (S (S O))))] (S (S (S O))) (S (S (S (S O)))) r
-- backward: x * y = 6  ==> (1,6) (2,3) (3,2) (6,1); the search does not terminate afterwards
? run [Blk Init [Asg (S (S O)) (Const O)] (Goto Test), Blk Test [] (IfZ (Var O) Done Outer), Blk Outer [Asg O (Pred (Var O)), Asg (S (S (S O))) (Var (S O))] (Goto Inner), Blk Inner [] (IfZ (Var (S (S (S O)))) Test Step), Blk Step [Asg (S (S (S O))) (Pred (Var (S (S (S O))))), Asg (S (S O)) (Succ (Var (S (S O))))] (Goto Inner), Blk Done [] (Return (Var (S (S O))))] x y (S (S (S (S (S (S O))))))
-- backward with one known input (division): 3 * y = 6
? run [Blk Init [Asg (S (S O)) (Const O)] (Goto Test), Blk Test [] (IfZ (Var O) Done Outer), Blk Outer [Asg O (Pred (Var O)), Asg (S (S (S O))) (Var (S O))] (Goto Inner), Blk Inner [] (IfZ (Var (S (S (S O)))) Test Step), Blk Step [Asg (S (S (S O))) (Pred (Var (S (S (S O))))), Asg (S (S O)) (Succ (Var (S (S O))))] (Goto Inner), Blk Done [] (Return (Var (S (S O))))] (S (S (S O))) y (S (S (S (S (S (S O))))))
